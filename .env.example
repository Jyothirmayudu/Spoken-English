# Copy this file to .env and fill in your own values before running in production.
# For local development, the defaults below are fine to leave as-is.

PORT=3000

# Used to sign login sessions (JWTs). Change this to any long random string
# before hosting this app publicly — anyone who knows this secret could
# forge a login. A quick way to generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-before-going-live
